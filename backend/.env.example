# Copy this file to ".env" and fill it in. Never commit your real .env to a PUBLIC repo.

# MongoDB Atlas (preferred):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Self-hosted Mongo in Docker (see README): mongodb://host.docker.internal:27017
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=encore

# Secret used to sign login tokens - change this to any long random string
JWT_SECRET=change-me-to-a-long-random-string

# If the database is empty when the server starts, fill it with sample data
AUTO_SEED=true

PORT=5000